generator client {
  provider = "prisma-client-js"
}

generator drizzle {
  provider = "drizzle-prisma-generator"
  output   = "../src/common/drizzle"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  employee
  intern
}

model DiscordUser {
  id            Int         @id @default(autoincrement())
  discordId     String      @unique
  username      String
  discriminator String?
  active        Boolean     @default(true)
  lastAccess    String?
  type          UserType    @default(employee)
  timesheets    TimeSheet[]
  created_at    DateTime    @default(now())
  updated_at    DateTime?   @updatedAt

  @@index([active])
  @@index([type])
  @@index([type, active])
}

model TimeSheet {
  id              Int         @id @default(autoincrement())
  discordUser     DiscordUser @relation(fields: [discordUserId], references: [discordId])
  discordUserId   String
  username        String
  timeIn          DateTime
  timeOut         DateTime?
  timeTotal       String?
  visibleTotal    Int?
  signatureDate   String?
  expectedTimeOut DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime?   @updatedAt

  @@index([discordUserId])
  @@index([discordUserId, signatureDate])
}
