generator client {
  provider = "prisma-client-js"
}

generator drizzle {
  provider = "drizzle-prisma-generator"
  output   = "../src/common/drizzle"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  employee
  intern
}

enum LeaveType {
  SL
  VL
  EL
  BDL
  OB
}

model DiscordUser {
  id            Int         @id @default(autoincrement())
  discordId     String      @unique
  username      String
  discriminator String?
  active        Boolean     @default(true)
  lastAccess    String?
  type          UserType    @default(employee)
  restDay       String?
  position      String?
  timesheets    TimeSheet[]
  leaves        Leave[]
  created_at    DateTime    @default(now())
  updated_at    DateTime?   @updatedAt

  @@index([active])
  @@index([type])
  @@index([type, active])
}

model TimeSheet {
  id              Int         @id @default(autoincrement())
  discordUser     DiscordUser @relation(fields: [discordUserId], references: [discordId])
  discordUserId   String
  username        String
  timeIn          DateTime
  timeOut         DateTime?
  timeTotal       String?
  visibleTotal    Int?
  signatureDate   String?
  expectedTimeOut DateTime?
  late            Boolean     @default(false)
  created_at      DateTime    @default(now())
  updated_at      DateTime?   @updatedAt

  @@index([discordUserId])
  @@index([signatureDate])
}

model Leave {
  id            Int        @id @default(autoincrement())
  discordUser   DiscordUser @relation(fields: [discordUserId], references: [discordId])
  discordUserId String
  date          String
  type          LeaveType
  note          String?
  created_at    DateTime   @default(now())
  updated_at    DateTime?  @updatedAt

  @@unique([discordUserId, date])
  @@index([discordUserId])
  @@index([date])
}

model Holiday {
  id         Int       @id @default(autoincrement())
  date       String    @unique
  name       String
  created_at DateTime  @default(now())
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  action     String
  targetId   String?
  detail     String?
  created_at DateTime @default(now())
}

enum OvertimeType {
  pre
  post
}

enum OvertimeStatus {
  pending
  approved
  rejected
}

model OvertimeRequest {
  id            Int             @id @default(autoincrement())
  discordUserId String
  date          String
  hours         Float
  type          OvertimeType
  status        OvertimeStatus  @default(pending)
  note          String?
  created_at    DateTime        @default(now())
  updated_at    DateTime?       @updatedAt

  @@index([discordUserId])
  @@index([date])
  @@index([status])
}
